---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Joe Hsu';
const description = 'Posts on software engineering, product, and building at GetWhys.';
const permalink = Astro.site.href;

let allPosts = await getCollection('posts')
allPosts = allPosts.sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());

const latestPost = allPosts[0];
const recentPosts = allPosts.slice(1, 5);
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-shell">
    <section class="hero container-wide" aria-labelledby="home-title">
      <div class="hero-copy-wrap">
        <p class="kicker"><span class="kicker-dot" aria-hidden="true"></span>Joe Hsu · Personal blog</p>
        <h1 id="home-title">Notes from the <em>building</em> side of software.</h1>
        <p class="hero-copy">
          Practical writing on AI products, agent systems, and the decisions that help good ideas ship.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#featured">Read the latest <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/blog">Browse the archive <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <aside class="hero-note" aria-label="About this blog">
        <span class="note-label">What you’ll find here</span>
        <p>Build notes, field reports, and useful edges discovered while making software.</p>
        <div class="note-footer">
          <span>{allPosts.length} posts</span>
          <span class="note-line" aria-hidden="true"></span>
          <span>Updated often</span>
        </div>
      </aside>
    </section>

    {latestPost && (
      <section id="featured" class="featured-section container-wide" aria-labelledby="featured-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Featured dispatch</p>
            <h2 id="featured-title">Start here</h2>
          </div>
          <span class="section-marker">{allPosts.length} posts</span>
        </div>

        <article class="featured-post">
          <a href={`/blog/${latestPost.data.slug}`}>
            <div class="featured-content">
              <div class="post-meta">
                <span>Latest post</span>
                <span>{latestPost.data.publishDate}</span>
              </div>
              <h3>{latestPost.data.title}</h3>
              <p>{latestPost.data.description}</p>
              <span class="button button-light">Read the post <span aria-hidden="true">↗</span></span>
            </div>
            <div class="featured-mark" aria-hidden="true">↗</div>
          </a>
        </article>
      </section>
    )}

    {recentPosts.length > 0 && (
      <section class="recent-section container-wide" aria-labelledby="recent-title">
        <div class="section-heading recent-heading">
          <div>
            <p class="eyebrow">Recent writing</p>
            <h2 id="recent-title">Notes from the workbench</h2>
          </div>
          <a class="text-link" href="/blog">View all posts <span aria-hidden="true">→</span></a>
        </div>

        <div class="post-grid">
          {recentPosts.map((post, index) => (
            <article class="post-card">
              <a href={`/blog/${post.data.slug}`}>
                <div class="card-topline">
                  <span class="post-number">{String(index + 2).padStart(2, '0')}</span>
                  <span class="meta-date">{post.data.publishDate}</span>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="card-link">Read note <span aria-hidden="true">↗</span></span>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="archive-prompt container-wide" aria-label="Browse the archive">
      <div>
        <p class="eyebrow">Keep exploring</p>
        <h2>The full archive, in chronological order.</h2>
      </div>
      <a class="button button-primary" href="/blog">See all posts <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .container-wide {
    margin: 0 auto;
    max-width: 1120px;
    width: 100%;
  }

  .home-shell {
    padding-bottom: 2rem;
  }

  .hero {
    align-items: end;
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1.5fr) minmax(220px, 0.65fr);
    padding: clamp(4.5rem, 10vw, 8rem) 0 clamp(4rem, 8vw, 6.5rem);
  }

  .kicker {
    align-items: center;
    display: flex;
    gap: 0.55rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-family-sans);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    color: var(--primary-color);
    font-weight: 700;
  }

  .kicker-dot {
    background: var(--primary-color);
    border-radius: 50%;
    height: 0.55rem;
    width: 0.55rem;
  }

  .hero h1 {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(3rem, 7vw, 6.25rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
    font-weight: 400;
  }

  .hero h1 em {
    color: var(--primary-color);
    font-style: italic;
  }

  .hero-copy-wrap {
    max-width: 720px;
  }

  .hero-copy {
    margin: 1.7rem 0 0;
    max-width: 48ch;
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1.3rem;
    margin-top: 2rem;
  }

  .hero-note {
    border-left: 1px solid var(--primary-color);
    margin-bottom: 0.45rem;
    padding: 0.25rem 0 0.25rem 1.5rem;
  }

  .note-label,
  .eyebrow,
  .section-marker,
  .post-meta,
  .meta-date,
  .post-number,
  .card-link {
    font-family: var(--font-family-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .note-label,
  .eyebrow,
  .section-marker,
  .meta-date,
  .post-number {
    color: var(--text-tertiary);
  }

  .hero-note p {
    color: var(--text-main);
    font-size: 1.08rem;
    line-height: 1.5;
    margin: 0.8rem 0 1.5rem;
  }

  .note-footer {
    align-items: center;
    color: var(--text-tertiary);
    display: flex;
    font-family: var(--font-family-sans);
    font-size: 0.7rem;
    gap: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .note-line {
    background: var(--surface-border);
    height: 1px;
    width: 1.8rem;
  }

  .button {
    align-items: center;
    border-radius: 999px;
    display: inline-flex;
    gap: 0.6rem;
    padding: 0.78rem 1.15rem;
    font-family: var(--font-family-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  }

  .button:hover {
    color: var(--button-text);
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--button-bg);
    border: 1px solid var(--button-border);
    color: var(--button-text);
  }

  .button-light {
    background: var(--button-text);
    color: var(--button-bg);
  }

  .button-light:hover {
    color: var(--button-bg);
  }

  .text-link {
    color: var(--text-main);
    font-family: var(--font-family-sans);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .text-link span {
    color: var(--primary-color);
    display: inline-block;
    margin-left: 0.35rem;
    transition: transform 180ms ease;
  }

  .text-link:hover span {
    transform: translateX(0.2rem);
  }

  .featured-section,
  .recent-section {
    margin-bottom: clamp(5rem, 10vw, 8rem);
  }

  .section-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.3rem;
  }

  .eyebrow {
    color: var(--primary-color);
    margin: 0 0 0.55rem;
  }

  .section-heading h2 {
    font-family: var(--font-family-serif);
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0;
  }

  .section-marker {
    margin-bottom: 0.25rem;
  }

  .featured-post {
    background: var(--button-bg);
    border-radius: 1.2rem;
    color: var(--button-text);
    overflow: hidden;
    position: relative;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .featured-post:hover,
  .featured-post:focus-within {
    box-shadow: 0 1.25rem 3rem var(--surface-shadow);
    transform: translateY(-3px);
  }

  .featured-post a {
    color: inherit;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11rem;
    min-height: 24rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    text-decoration: none;
  }

  .featured-content {
    align-self: end;
    max-width: 700px;
  }

  .post-meta {
    color: var(--button-text);
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.5rem;
    margin-bottom: 1.4rem;
  }

  .featured-content h3 {
    font-family: var(--font-family-serif);
    font-size: clamp(2.1rem, 5vw, 4.25rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.98;
    margin: 0;
    max-width: 14ch;
  }

  .featured-content p {
    color: var(--button-text);
    font-size: 1.05rem;
    line-height: 1.55;
    margin: 1.25rem 0 1.7rem;
    max-width: 52ch;
  }

  .featured-mark {
    align-self: start;
    color: var(--primary-color);
    font-family: var(--font-family-sans);
    font-size: clamp(5rem, 13vw, 11rem);
    font-weight: 300;
    justify-self: end;
    line-height: 0.7;
    opacity: 0.9;
  }

  .recent-heading {
    align-items: center;
  }

  .post-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .post-card {
    background: var(--surface-muted);
    border: 1px solid var(--surface-border);
    border-radius: 0.9rem;
    min-height: 18rem;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .post-card:hover,
  .post-card:focus-within {
    border-color: var(--primary-color);
    box-shadow: 0 1rem 2.25rem var(--surface-shadow);
    transform: translateY(-3px);
  }

  .post-card a {
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.3rem, 3vw, 2rem);
    text-decoration: none;
  }

  .card-topline {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-bottom: 2.8rem;
  }

  .post-number {
    color: var(--primary-color);
  }

  .post-card h3 {
    margin: 0;
    font-family: var(--font-family-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.08;
    max-width: 17ch;
  }

  .post-card p {
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.55;
    margin: 1rem 0 1.5rem;
  }

  .card-link {
    color: var(--text-main);
    margin-top: auto;
  }

  .card-link span {
    color: var(--primary-color);
    font-size: 1rem;
    margin-left: 0.35rem;
  }

  .archive-prompt {
    align-items: center;
    background: var(--surface-elevated);
    border: 1px solid var(--surface-border);
    border-radius: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .archive-prompt h2 {
    font-family: var(--font-family-serif);
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin: 0;
  }

  a:focus-visible {
    outline: 3px solid var(--primary-color);
    outline-offset: 4px;
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(210px, 0.75fr);
    }
  }

  @media (max-width: 760px) {
    .hero {
      display: block;
      padding-bottom: 4.5rem;
    }

    .hero h1 {
      max-width: 10ch;
    }

    .hero-note {
      margin-top: 3rem;
      max-width: 24rem;
    }

    .featured-post a {
      display: block;
      min-height: 0;
    }

    .featured-mark {
      font-size: 6rem;
      margin: 3rem 0 -0.5rem;
      text-align: right;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }

    .post-card {
      min-height: 16rem;
    }

    .archive-prompt {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .section-heading,
    .recent-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .featured-content h3 {
      font-size: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .text-link span,
    .featured-post,
    .post-card {
      transition: none;
    }
  }
</style>
